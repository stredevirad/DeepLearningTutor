# Copy this file to `.env` and fill in your own values. `.env` is git-ignored.

# One or more Gemini API keys, comma-separated (the app rotates between them
# when one hits its rate limit). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEYS=key1,key2

# Optional: where the local Ollama server listens (default shown).
# OLLAMA_HOST=http://127.0.0.1:11434

# Optional: shared secret for the MCP training server (mcp_server.py). When set,
# the server rejects requests that do not send "Authorization: Bearer <token>",
# and the app's MCP client sends it automatically.
# MCP_AUTH_TOKEN=change-me
